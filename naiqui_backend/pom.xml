<?xml version="1.0" encoding="UTF-8"?>
<!--
    pom.xml
    =======
    Archivo de configuración de Maven. Acá se define:
      - De qué "parent" hereda el proyecto (spring-boot-starter-parent), que ya trae
        versiones compatibles de todas las librerías de Spring.
      - Los datos del proyecto (groupId, artifactId, version).
      - Las dependencias (librerías) que vamos a usar.
      - El plugin que empaqueta la app como un .jar ejecutable.

    Se usan artifactIds válidos de Maven Central y versiones administradas por
    Spring Boot para mantener el proyecto compilable.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Proyecto "padre" de Spring Boot: fija versiones compatibles entre sí -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/> <!-- se busca en el repositorio remoto, no en el disco -->
	</parent>

	<!-- Identificación del proyecto (Group/Artifact/Version -> coordenadas Maven) -->
	<groupId>com.uade</groupId>
	<artifactId>naiqui_backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>naiqui_backend</name>
	<description>TPO - E-commerce de zapatillas - Spring Boot + Spring Data JPA</description>

	<properties>
		<!-- Versión de Java que se usa para compilar y correr el proyecto -->
		<java.version>17</java.version>
		<lombok.version>1.18.48</lombok.version>
	</properties>

	<dependencies>
		<!-- Habilita Spring Web MVC: @RestController, @RequestMapping, servidor Tomcat embebido, etc. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Habilita Spring Data JPA: repositorios, Hibernate como implementación de JPA -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Validaciones de Bean Validation (@NotNull, @NotBlank, etc.) sobre los DTOs -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- BCrypt para cifrar/validar contraseñas -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- Spring Security para proteger endpoints y validar JWT -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- JWT para firmar y validar tokens de sesión -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.11.5</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Driver de MySQL, la única base de datos soportada por la aplicación y sus pruebas. -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		    Lombok: genera automáticamente (en tiempo de compilación) los getters,
		    setters, constructores, equals/hashCode, toString, etc. a partir de
		    anotaciones como @Data, @Getter, @Setter, @Builder. Evita escribir
		    código repetitivo ("boilerplate") a mano.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Dependencias necesarias solo para correr los tests (JUnit, Mockito, etc.) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Plugin que arma el .jar ejecutable ("fat jar") y permite correr con mvn spring-boot:run -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Excluye a Lombok del jar final: solo hace falta en tiempo de compilación -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
